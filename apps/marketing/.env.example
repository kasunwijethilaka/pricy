# URL of the web zone (the "/app" zone). The marketing app rewrites /app/*
# to this origin. Locally you can leave this unset — next.config.mjs falls
# back to http://localhost:3001. In production (Vercel), set it to the web
# zone's deployment URL, e.g. https://app.pricy.com
WEB_ZONE_URL=http://localhost:3001

# URL of the admin zone (the "/admin" zone). The marketing app rewrites
# /admin/* to this origin. Locally falls back to http://localhost:3002.
# In production set it to the admin zone's deployment URL, e.g.
# https://admin.pricy.com
ADMIN_ZONE_URL=http://localhost:3002
