# Local dev — Docker Postgres from the repo-root docker-compose.yml.
# Copy this file to `.env` (which is git-ignored) to use it.
DATABASE_URL=postgres://pricy:pricy@localhost:5432/pricy

# Production uses Neon (serverless Postgres) — same URL format, different host,
# and TLS required. Set this in Vercel, not here. Example shape:
# DATABASE_URL=postgres://<user>:<password>@<neon-host>/<db>?sslmode=require
